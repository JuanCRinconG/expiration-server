<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExpirationServer</RootNamespace>
    <AssemblyName>ExpirationNotifServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="Google.Cloud.Firestore" Version="4.5.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="expiration-settings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared database spine from chem-classify (no auth, OneDrive, or desktop partials). -->
  <ItemGroup>
    <Compile Include="..\chem-classify\Backend\DatabaseTopology.cs" Link="Backend\DatabaseTopology.cs" />
    <Compile Include="..\chem-classify\Backend\InventoryFieldReaders.cs" Link="Backend\InventoryFieldReaders.cs" />
    <Compile Include="..\chem-classify\Backend\DataTools.cs" Link="Backend\DataTools.cs" />
    <Compile Include="..\chem-classify\Backend\ItemRecords.cs" Link="Backend\ItemRecords.cs" />
    <Compile Include="..\chem-classify\Backend\NotifRule.cs" Link="Backend\NotifRule.cs" />
    <Compile Include="..\chem-classify\Backend\StorageService.cs" Link="Backend\StorageService.cs" />
    <Compile Include="..\chem-classify\Backend\Firebase\FirebaseConnect.cs" Link="Backend\Firebase\FirebaseConnect.cs" />
    <Compile Include="..\chem-classify\Backend\Firebase\FirebaseDataTools.cs" Link="Backend\Firebase\FirebaseDataTools.cs" />
    <Compile Include="..\chem-classify\Backend\Firebase\InventoryDocumentPipeline.cs" Link="Backend\Firebase\InventoryDocumentPipeline.cs" />
    <Compile Include="..\chem-classify\Backend\Firebase\NotifAlertFirestoreSupport.cs" Link="Backend\Firebase\NotifAlertFirestoreSupport.cs" />
  </ItemGroup>
</Project>
